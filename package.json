{
  "name": "diamond-hardhat-template",
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Conight",
    "url": "https://github.com/Conight"
  },
  "description": "Hardhat and Viem integration for ERC-8153 facet-based diamonds using Compose",
  "scripts": {
    "generate": "wagmi generate",
    "prettier": "prettier --write --plugin=prettier-plugin-solidity \"contracts/customNFT/**/*.sol\" \"contracts/test/**/*.sol\" \"{scripts,tasks,config,test}/**/*.ts\" \"*.ts\" \"*.json\" README.md",
    "lint": "prettier --check --plugin=prettier-plugin-solidity \"contracts/customNFT/**/*.sol\" \"contracts/test/**/*.sol\" \"{scripts,tasks,config,test}/**/*.ts\" \"*.ts\" \"*.json\" README.md",
    "test": "hardhat test",
    "compile": "hardhat compile",
    "selectors": "hardhat selectors",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.2",
    "@types/node": "^25.1.0",
    "@wagmi/cli": "^2.9.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.2.1",
    "typescript": "~5.9.3",
    "viem": "^2.45.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "engines": {
    "node": ">=22.10.0"
  }
}
