{
  "name": "diamond-hardhat-template",
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Conight",
    "url": "https://github.com/Conight"
  },
  "description": "Hardhat and Viem integration for ERC-8153 facet-based diamonds using Compose",
  "scripts": {
    "generate": "wagmi generate",
    "prettier": "prettier --write --plugin=prettier-plugin-solidity \"contracts/customNFT/**/*.sol\" \"contracts/test/**/*.sol\" \"{scripts,tasks,config,test}/**/*.ts\" \"*.ts\" \"*.json\" README.md",
    "lint": "prettier --check --plugin=prettier-plugin-solidity \"contracts/customNFT/**/*.sol\" \"contracts/test/**/*.sol\" \"{scripts,tasks,config,test}/**/*.ts\" \"*.ts\" \"*.json\" README.md",
    "test": "hardhat test",
    "compile": "hardhat compile",
    "selectors": "hardhat selectors",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.6.2",
    "@wagmi/cli": "^2.10.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.17.0",
    "prettier": "^3.9.9",
    "prettier-plugin-solidity": "^2.4.1",
    "typescript": "~7.0.2",
    "viem": "^2.56.8"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=22.13.0"
  }
}
